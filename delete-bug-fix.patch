+			runOnUiThread(new Runnable() {
+				@Override
+				public void run() {
+					String message = getResources().getQuantityString(R.plurals.deleted, finalUntracked, finalUntracked);
+					showToast(message, Toast.LENGTH_SHORT);
+				}
+			});
+			return;
+		}
+
+		final PendingIntent deleteRequest;
